PORT=4000
JWT_SECRET=REPLACE_WITH_RANDOM_SECRET_AT_LEAST_32_CHARACTERS
JWT_EXPIRES_IN=8h
# Ganti nilai contoh sebelum digunakan; password production minimal 16 karakter.
ADMIN_EMAIL=admin@topscore.co.id
ADMIN_PASSWORD=CHANGE_ME_BEFORE_USE_minimum_16_chars
# Domain email yang boleh registrasi, dipisahkan koma jika lebih dari satu.
ALLOWED_EMAIL_DOMAINS=topscore.co.id
# Relatif terhadap backend/ atau path absolut; arahkan ke penyimpanan terpisah untuk production.
BACKUP_DIR=backups
# Untuk local dev:
CORS_ORIGIN=http://localhost:5173
# Untuk production (Vercel):
# CORS_ORIGIN=https://lelangaset.vercel.app
m